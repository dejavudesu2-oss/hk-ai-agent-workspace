# ==============================================================================
# HK AI Agent Workspace - Environment Configuration
# ==============================================================================

# LLM Provider Configuration: 'mock' (default, free offline simulator) or 'real'
LLM_PROVIDER=mock

# Live API Keys (Optional: Leave blank to use zero-cost mock streaming provider)
# DeepSeek API (Hong Kong direct access, 12-20ms network ping RTT; prefill TTFT measured separately)
DEEPSEEK_API_KEY=

# SiliconFlow / DashScope API (Failover fallback)
SILICONFLOW_API_KEY=

# Server runtime settings
PORT=3000
NODE_ENV=development
