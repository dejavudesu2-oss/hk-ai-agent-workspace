{
  "name": "hk-ai-agent-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm --workspace=app run dev",
    "build": "npm --workspace=app run build",
    "start": "npm --workspace=app run start",
    "test": "npm --workspace=app run test",
    "test:chat": "npx tsx scripts/test_chat_stream.js",
    "test:vfs": "npx tsx scripts/test_vfs_stream.js",
    "bench:density": "node bench/container_density.js",
    "bench:load": "npx tsx bench/loadtest.js",
    "test:e2e": "npx tsx scripts/e2e_test.js",
    "verify:fixtures": "node scripts/verify-fixtures.js",
    "cost:v2": "node scripts/cost_v2.js",
    "cost:v3": "node scripts/breakeven_v3.js",
    "secrets:scan": "node scripts/secrets_scan.js",
    "test:browser": "node scripts/browser_proof.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
